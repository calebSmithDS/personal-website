---
import type { Project } from '../data/projects';
import ProjectCard from './ProjectCard.astro';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;

const allTags = Array.from(
  new Set(projects.flatMap((project) => project.tags))
).sort();
---

<section id="projects" class="projects-section">
  <div class="container">
    <div class="projects-toolbar">
      <div class="toolbar-left">
        <div class="projects-header-title">
          <svg class="folder-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
          </svg>
          <span class="folder-prefix">//</span>
          <span class="projects-title-text">PROJECTS</span>
          <span class="projects-count">({projects.length})</span>
        </div>
      </div>

      <div class="toolbar-right">
        <div class="search-box">
          <svg class="search-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <label for="project-search" class="sr-only">Filter projects</label>
          <input
            id="project-search"
            type="search"
            placeholder="Filter projects..."
            autocomplete="off"
          />
        </div>

        <div class="tag-bar" role="group" aria-label="Filter by tag">
          <button type="button" class="tag-btn is-active" data-tag="all">
            All
          </button>
          {
            allTags.map((tag) => (
              <button type="button" class="tag-btn" data-tag={tag.toLowerCase()}>
                {tag}
              </button>
            ))
          }
        </div>
      </div>
    </div>

    <div class="projects-grid">
      {projects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>

    <p id="empty-state" class="empty-state" hidden>
      No matching projects found.
    </p>
  </div>
</section>

<script>
  const searchInput = document.getElementById('project-search') as HTMLInputElement | null;
  const tagButtons = document.querySelectorAll<HTMLButtonElement>('.tag-btn');
  const cardWrappers = document.querySelectorAll<HTMLElement>('.card-wrapper');
  const emptyState = document.getElementById('empty-state');

  let activeTag = 'all';

  const applyFilters = () => {
    const query = (searchInput?.value ?? '').trim().toLowerCase();
    let visibleCount = 0;

    cardWrappers.forEach((wrapper) => {
      const title = wrapper.dataset.title ?? '';
      const description = wrapper.dataset.description ?? '';
      const tags = (wrapper.dataset.tags ?? '').split(',');

      const matchesTag = activeTag === 'all' || tags.includes(activeTag);
      const matchesQuery =
        query === '' ||
        title.includes(query) ||
        description.includes(query) ||
        tags.some((tag) => tag.includes(query));

      const isVisible = matchesTag && matchesQuery;
      wrapper.classList.toggle('is-hidden', !isVisible);
      if (isVisible) visibleCount += 1;
    });

    if (emptyState) {
      emptyState.hidden = visibleCount > 0;
    }
  };

  searchInput?.addEventListener('input', applyFilters);

  tagButtons.forEach((button) => {
    button.addEventListener('click', () => {
      tagButtons.forEach((btn) => btn.classList.remove('is-active'));
      button.classList.add('is-active');
      activeTag = button.dataset.tag ?? 'all';
      applyFilters();
    });
  });
</script>

<style>
  .projects-section {
    padding: 3rem 0 2rem;
  }

  .projects-toolbar {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }

  .toolbar-left {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .projects-header-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 500;
  }

  .folder-icon {
    color: var(--accent);
    flex-shrink: 0;
  }

  .folder-prefix {
    color: var(--text-muted);
    opacity: 0.7;
  }

  .projects-title-text {
    letter-spacing: 0.08em;
    color: var(--text-primary);
  }

  .projects-count {
    color: var(--accent);
    font-weight: 600;
  }

  .projects-subtext {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text-muted);
    opacity: 0.85;
    margin: 0;
  }

  .projects-subtext kbd {
    display: inline-block;
    padding: 0.1rem 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: 4px;
    color: var(--text-primary);
  }

  .toolbar-right {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .search-box {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-icon {
    position: absolute;
    left: 0.75rem;
    color: var(--text-muted);
    opacity: 0.6;
    pointer-events: none;
  }

  .search-box input {
    background-color: var(--bg-secondary);
    color: var(--text-primary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 0.45rem 0.85rem 0.45rem 2.2rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    width: 200px;
    transition: border-color 0.15s ease;
  }

  .search-box input:focus {
    outline: none;
    border-color: var(--accent);
  }

  .search-box input::placeholder {
    color: var(--text-muted);
    opacity: 0.65;
  }

  .tag-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag-btn {
    background-color: var(--bg-secondary);
    color: var(--text-muted);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 0.35rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .tag-btn:hover {
    border-color: var(--border-hover);
    color: var(--text-primary);
  }

  .tag-btn.is-active {
    background-color: var(--accent-dim);
    border-color: var(--accent);
    color: var(--accent);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .empty-state {
    text-align: center;
    padding: 3rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .projects-toolbar {
      flex-direction: column;
      gap: 1.25rem;
    }

    .toolbar-right {
      width: 100%;
    }

    .search-box {
      width: 100%;
    }

    .search-box input {
      width: 100%;
    }
  }
</style>
